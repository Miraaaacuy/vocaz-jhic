# ── Database (MySQL / MariaDB) ──
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://vocaz_user:ganti_password@localhost:3306/vocaz"

# ── Auth.js ──
# Buat secret acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# URL publik website (tanpa garis miring di akhir)
AUTH_URL="https://vocaz.domainanda.com"
AUTH_TRUST_HOST=true

# ── Login Google & Facebook (opsional — tombol tetap tampil, tapi baru berfungsi jika diisi;
#    pengguna menautkan akunnya di Pengaturan → Akun tertaut) ──
# Google : https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application)
#          Authorized redirect URI: https://vocaz.domainanda.com/api/auth/callback/google
# Facebook: https://developers.facebook.com/apps → Facebook Login → Valid OAuth Redirect URIs:
#          https://vocaz.domainanda.com/api/auth/callback/facebook
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# ── Upload file (video, sertifikat, dokumen, avatar) ──
# Gunakan path absolut di luar folder aplikasi agar tidak hilang saat deploy ulang
UPLOAD_DIR="/home/USERNAME/vocaz-uploads"

# Port aplikasi Node.js
PORT=3000
